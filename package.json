{
  "name": "holoscene-aframe-physics",
  "version": "1.0.0",
  "private": true,
  "type": "commonjs",
  "description": "Avaliacao reprodutivel das malhas do HoloScene (Xia et al., 2025) em A-Frame com fisica Ammo, na cena replica_room_0",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "setup:meshes": "node scripts/00_copy_meshes.mjs",
    "convert": "node scripts/02_convert.mjs",
    "center": "node scripts/03_center_models.mjs",
    "serve": "http-server scene -p 8088 -c-1",
    "bench": "node scripts/04_bench.mjs",
    "bench:smoke": "node scripts/04_bench.mjs --smoke",
    "shots": "node scripts/06_screenshots.mjs"
  },
  "keywords": [
    "holoscene",
    "aframe",
    "ammo.js",
    "gltf",
    "physics",
    "3d-reconstruction",
    "replica-dataset"
  ],
  "dependencies": {
    "@c-frame/aframe-physics-system": "4.2.4",
    "@gltf-transform/cli": "4.5.1",
    "@gltf-transform/core": "4.5.1",
    "@gltf-transform/extensions": "4.5.1",
    "@gltf-transform/functions": "4.5.1",
    "aframe": "1.8.0",
    "gltf-validator": "2.0.0-dev.3.10",
    "http-server": "14.1.1",
    "meshoptimizer": "1.3.0",
    "obj2gltf": "3.2.0",
    "playwright-core": "1.64.1",
    "sharp": "0.35.5"
  }
}
